{
	"name": "{{project_name}}",
	"version": "0.1.0",
	"description": "{{description}}",
	"type": "module",
	"repository": "{{repository}}",
	"author": "{{author}}",
	"license": "MIT",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rimraf dist && tsc",
		"debug": "rapidrest dev --inspect",
		"dev": "rapidrest dev",
		"docs": "typedoc --plugin typedoc-plugin-markdown --out docs/reference --target esnext --mode file src",
		"lint": "eslint ./src ./test",
		"local-audit": "{{#if pkgMgr.yarn}}yarn{{else}}npm{{/if}} install && yarn npm audit -A -R \"$@\"",
		"checkup": "{{#if pkgMgr.yarn}}yarn dlx{{else}}npx{{/if}} @yarnpkg/doctor \"$@\"",
		"dependency-check": "{{#if pkgMgr.yarn}}yarn dlx{{else}}npx{{/if}} depcheck \"$@\"",
		"report-coverage": "cat ./coverage/lcov.info | coveralls",
		"profile:process": "node --prof-process --call-graph",
		"profile:view": "npx speedscope",
		"start": "rapidrest start",
		"test": "vitest run --coverage",
		"test:prod": "{{#if pkgMgr.yarn}}yarn{{else}}npm run{{/if}} lint && {{#if pkgMgr.yarn}}yarn{{else}}npm run{{/if}} test",
		"test:watch": "vitest --coverage",
		"version": "git add README.md",
		"postversion": "git push --follow-tags"
	},
	"prettier": {
		"printWidth": 120,
		"semi": true,
		"singleQuote": false,
		"tabWidth": 4,
		"trailingComma": "es5"
	},
	"dependencies": {
		"@rapidrest/core": "^5.0.1",
		"@rapidrest/service-core": "^1.2.1",
		"@types/node": "^26.2.0",
		"axios": "^1.19.0",
		"lodash-es": "^4.18.1",
		{{#if features.mongodb}}"mongodb": "^7.5.0",{{/if}}
		"nconf": "^0.13.0",
		"openapi3-ts": "^4.6.1",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		{{#if features.redis}}"redis": "^6.2.1",{{/if}}
		{{#if features.postgresql}}"typeorm": "^1.1.0",{{/if}}
		"winston": "^3.19.0",
		"winston-transport": "^4.9.0"
	},
	"devDependencies": {
		"@rapidrest/cli": "^0.18.0",
		"@swc/core": "^1.16.1",
		"@types/nconf": "^0.10.7",
		"@vitest/coverage-v8": "^4.1.11",
		"coveralls": "^3.1.1",
		"eslint": "^10.5.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.2",
		"globals": "^17.11.0",
		{{#if features.mongodb}}"mongodb-memory-server": "^11.2.0",{{/if}}
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.12",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"unplugin-swc": "^1.5.11",
		"uuid": "^14.0.2",
		"vitest": "^4.1.11"
	},
	"resolutions": {
		"semver": "^7.5.2",
		"axios": "^1.17.0",
		"json-schema": "^0.4.0"
	},
	{{#if pkgMgr.yarn}}"packageManager": "yarn@4.2.2",{{/if}}
	"engines": {
		"node": ">=24.0.0"
	}
}
