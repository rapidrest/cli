{
	"name": "{{project_name}}",
	"version": "0.1.0",
	"description": "{{description}}",
	"type": "module",
	"repository": "{{repository}}",
	"author": "{{author}}",
	"license": "MIT",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rapidrest build",
		"debug": "rapidrest dev --inspect",
		"dev": "rapidrest dev",
		"lint": "eslint ./src ./test",
		"local-audit": "{{#if pkgMgr.yarn}}yarn{{else}}npm{{/if}} install && yarn npm audit -A -R \"$@\"",
		"checkup": "{{#if pkgMgr.yarn}}yarn dlx{{else}}npx{{/if}} @yarnpkg/doctor \"$@\"",
		"dependency-check": "{{#if pkgMgr.yarn}}yarn dlx{{else}}npx{{/if}} depcheck \"$@\"",
		"profile:process": "node --prof-process --call-graph",
		"profile:view": "npx speedscope",
		"start": "rapidrest start",
		"test": "rapidrest test --coverage",
		"test:watch": "rapidrest test --watch --coverage",
		"release": "rapidrest release"
	},
	"prettier": {
		"printWidth": 120,
		"semi": true,
		"singleQuote": false,
		"tabWidth": 4,
		"trailingComma": "es5"
	},
	"dependencies": {
		"@rapidrest/core": "^6",
		"@rapidrest/service-core": "^2",
		"@types/node": "^26",
		"axios": "^1",
		"lodash-es": "^4",
		{{#if features.mongodb}}"mongodb": "^7",{{/if}}
		"nconf": "^0.13",
		"openapi3-ts": "^4",
		{{#if features.postgresql}}"pg": "^8",{{/if}}
		{{#if features.sqlite}}"better-sqlite3": "^13",{{/if}}
		"prom-client": "^15",
		"reflect-metadata": "^0.2",
		{{#if features.redis}}"redis": "^6",{{/if}}
		{{#if features.hasSqlDatastore}}"typeorm": "^1.1.0",{{/if}}
		"winston": "^3",
		"winston-transport": "^4"
	},
	"devDependencies": {
		"@rapidrest/cli": "^{{cliVersion}}",
		"@swc/core": "^1",
		"@types/nconf": "^0.10",
		{{#if features.hasSqlDatastore}}"@types/better-sqlite3": "^9",{{/if}}
		"@typescript-eslint/eslint-plugin": "^8",
		"@typescript-eslint/parser": "^8",
		"@vitest/coverage-v8": "^4",
		{{#if features.postgresql}}{{#unless features.sqlite}}"better-sqlite3": "^13",{{/unless}}{{/if}}
		"eslint": "^10",
		"eslint-plugin-jsdoc": "^64",
		"globals": "^17",
		{{#if features.mongodb}}"mongodb-memory-server": "^11",{{/if}}
		"nodemon": "^3",
		"rimraf": "^6",
		{{#unless features.redis}}"redis": "^6",{{/unless}}
		"tsx": "^4",
		{{#unless features.hasSqlDatastore}}"typeorm": "^1.1.0",{{/unless}}
		"typescript": "^6",
		"unplugin-swc": "^1",
		"uuid": "^14",
		"vitest": "^4"
	},
	"resolutions": {
		"cross-spawn": "^7.0.6"
	},
	"rapidrest": {
		"templates": "{{templatesVersion}}"
	},
	{{#if pkgMgr.yarn}}"packageManager": "yarn@4.2.2",{{/if}}
	"engines": {
		"node": ">=24.0.0"
	}
}
