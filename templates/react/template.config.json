{
  "conditionalFiles": [],
  "helmPaths": [],
  "patches": [
    {
      "template": "patches/package.json",
      "target": "package.json",
      "strategy": "json-merge"
    },
    {
      "template": "patches/tsconfig.json",
      "target": "tsconfig.json",
      "strategy": "json-merge"
    },
    {
      "template": "patches/config-class-loader-ignore.txt",
      "target": "src/config.ts",
      "strategy": "ts-property-set",
      "insertInto": "class_loader",
      "property": "ignore"
    },
    {
      "template": "patches/config-class-loader-ignore.txt",
      "target": "test/config.ts",
      "strategy": "ts-property-set",
      "insertInto": "class_loader",
      "property": "ignore"
    },
    {
      "template": "patches/config-react-manifest.txt",
      "target": "src/config.ts",
      "strategy": "ts-block-insert",
      "insertInto": "",
      "idempotencyKey": "react",
      "condition": "hydrate"
    }
  ]
}
